# ==============================================================================
# FlameRoar RPG Learning Platform — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Deployment Settings
# ------------------------------------------------------------------------------
# Port for the backend API server (default: 5055)
PORT=5055
# Environment mode: development | production | test
NODE_ENV=development
# Base URL for frontend API calls (default: http://localhost:5055/api in dev, /api in prod)
VITE_API_BASE_URL=http://localhost:5055/api
# CORS Allowed origins (comma-separated, e.g., https://flameroar.dev,https://app.flameroar.dev)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Set to true to bypass strict origin checks in demo/staging environments
ALLOW_ALL_CORS=true

# ------------------------------------------------------------------------------
# 2. Zero-Config Mock Mode (Recruiter / Demo Friendly)
# ------------------------------------------------------------------------------
# When set to true, the system runs entirely in memory without requiring
# MongoDB or external Clerk authentication keys. Ideal for quick evaluations!
MOCK_MODE=true

# ------------------------------------------------------------------------------
# 3. Database Connection (Required when MOCK_MODE=false)
# ------------------------------------------------------------------------------
# MongoDB connection string (e.g., MongoDB Atlas or local instance)
MONGODB_URI=mongodb+srv://your_user:your_password@cluster.mongodb.net/rpg_learning

# ------------------------------------------------------------------------------
# 4. Authentication (Clerk) — Required when MOCK_MODE=false
# ------------------------------------------------------------------------------
# Retrieve keys from https://clerk.com/dashboard
CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# ------------------------------------------------------------------------------
# 5. Artificial Intelligence Providers
# ------------------------------------------------------------------------------
# Provide at least one API key to power dynamic AI question & lesson generation.
# If no key is provided, the engine gracefully falls back to built-in mock AI lore.
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
GROQ_API_KEY=your_groq_api_key

# ------------------------------------------------------------------------------
# 6. Code Execution & System Security
# ------------------------------------------------------------------------------
# Optional Judge0 API key for remote code compilation (falls back to local execution)
JUDGE0_KEY=your_judge0_api_key
# Internal system secret for protected admin/refill endpoints
SYSTEM_SECRET=flameroar_secret_token
